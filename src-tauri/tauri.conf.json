{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cuaderno FP",
  "version": "26.10.24",
  "identifier": "com.cuadernofp.desktop",
  "build": {
    "frontendDist": "../frontend/out",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Cuaderno FP",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://accounts.google.com https://www.googleapis.com https://oauth2.googleapis.com https://login.microsoftonline.com https://graph.microsoft.com https://cdd-backend-215337606799.europe-west1.run.app; worker-src 'self' blob:; frame-src 'self' blob: http://127.0.0.1:*; object-src 'self' blob:; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cuadernofp-backend"
    ],
    "resources": {
      "../backend/cdd_pro.db": "cdd_pro.db"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxQkI1NzU5MTlGNjhFNjUKUldSbGp2WVpXVmU3a1RJNGl0Z0ZjcnkyODhqUDBuU3VPVGVtWWhlSGVwY2xRdkQxZUl6My81V00K",
      "endpoints": [
        "https://github.com/rafaelsanzprades/CuadernoFP/releases/latest/download/latest.json"
      ]
    }
  }
}
